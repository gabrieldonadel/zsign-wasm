{
  "name": "zsign-wasm",
  "version": "0.0.2",
  "description": "WASM full resigning toolkit packaged with stable src/dist/binary directories.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./binary/zsign-wasm.min.js": "./binary/zsign-wasm.min.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "binary/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:wasm": "cd build/wasm && make clean && make bundle",
    "build:dist": "bunx tsc -p tsconfig.json",
    "build": "bun run build:wasm && bun run build:dist",
    "clean": "rm -rf dist binary",
    "prepack": "bun run build"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "typescript": "~5.9.3"
  }
}
